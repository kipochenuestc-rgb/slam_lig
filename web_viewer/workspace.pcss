@tailwind utilities;
:root {
  color-scheme:light;
  --work:#f1f2f3; --panel:#fff; --inset:#f6f7f8; --edge:#cdd1d5;
  --ink:#252a30; --muted:#535e68; --action:#ffb338; --active:#f29619;
  --tint:#ffdfaa; --accent-ink:#713b00; --green:var(--accent-ink);
  background:var(--work); color:var(--ink);
}
body,body.mapping-page,body:has(#bagForm),#studio {background:var(--work);color:var(--ink);font-family:"Segoe UI","Microsoft YaHei UI",sans-serif}
body input,body select,body textarea,dialog,.bar select,.directory-picker input,#browse input,.height-inputs input,#export-dialog select,.appearance input[type=number] {
  color:var(--ink);background:var(--panel);border:1px solid var(--edge);border-radius:3px
}
input[type=checkbox],input[type=range],.point-size input {accent-color:#d77e00}
:focus-visible {outline:2px solid #8a4c00;outline-offset:2px}
.bar,.toolbar,.directory-picker,body:has(#bagForm)>header {background:var(--panel);color:var(--ink);border-color:var(--edge);box-shadow:none}
.bar{padding:10px clamp(12px,2vw,30px);grid-template-columns:auto 1fr}
.bar .brand,.sidebar .brand{font-size:19px;letter-spacing:-.03em;font-weight:650;color:var(--ink)}
.bar nav{align-items:center;gap:5px}.bar nav .ant-btn,.bar nav a{display:inline-flex;align-items:center;gap:5px;height:33px;padding:5px 11px;line-height:21px}
.bar nav .ant-btn .anticon+span{margin:0}
.map-picker{padding-top:8px;border-top:1px solid var(--edge)}
.notice,.dialog-info{color:#71410c;background:#fff0d9}
.mapping-page main{max-width:1760px;padding:16px clamp(12px,2.2vw,34px) 24px}
#mapping-panel{padding:0;margin:0;border:0;background:transparent;color:var(--ink)}
.mapping-heading{justify-content:flex-start}.mapping-heading>div{margin-right:auto}
.mapping-heading h1{font-size:clamp(21px,2.2vw,31px);letter-spacing:-.02em}.mapping-heading p{margin:4px 0}
#mapping-panel p,#mapping-panel pre,.rate-limits,.directory-picker small,.toolbar .title span,.info-panel span,.point-size output{color:var(--muted)}
.mapping-workspace{grid-template-columns:minmax(0,1.6fr) minmax(280px,1fr);align-items:start;gap:12px;margin-top:15px}
.workspace-card,.metrics,.map-card,.session,.processing-summary,.sidebar,dialog,.map-toolbar,.map-footer {
  background:var(--panel);border-color:var(--edge);border-radius:3px;color:var(--ink);box-shadow:none
}
.workspace-card {padding:14px}.workspace-card h2{font-size:15px;font-weight:650;color:var(--ink)}
.workspace-card.mapping-columns{grid-column:2;grid-row:1;display:flex;flex-direction:column;gap:12px}
.workspace-card.rig-section{grid-column:1;grid-row:1;margin:0;padding:14px;position:relative}
.workspace-card.rig-layout{grid-column:1/-1;grid-row:2}
.mapping-task{padding:12px 0 0;border:0;border-top:1px solid var(--edge)}
#folders{max-height:135px}#folders button,.rig-layout td,.rig-layout th{border-color:var(--edge)}
#rig-table th,.rig-section output,.mapping-task pre,.view-switch,.chip{color:var(--ink);background:var(--inset)}
#rig-table td small,#rig-table .frame-id,#rig-context{color:var(--muted)}
.rig-layout tr.selected{background:#fff4e2}
#rig-canvas{user-select:none;touch-action:none;cursor:grab;height:clamp(260px,38vh,470px);max-height:none;aspect-ratio:auto;background:#eceef0;border-color:var(--edge);border-radius:2px}
.rig-views{justify-content:flex-end}
.rig-section output,.mapping-task pre{padding:9px;border:1px solid var(--edge);border-radius:2px}
.rig-section summary,.rate-control output,#pos{color:var(--ink)}
#mapping-panel #error,#map-error{color:#a03021}
[hidden]{display:none!important}
.sidebar h2,h1,.metrics strong,.section-title,.processing-summary strong,dialog h2 {color:var(--ink)}
.nav-active,.session-tag,.dialog-info{background:#fff1da;color:var(--accent-ink)}
.layers label,.layers label small,.subtitle,.breadcrumb,.metrics small,.metrics span,.session p,.sidebar dt,.sidebar dd,.appearance label,.map-footer span,footer,.map-status,.processing-summary span{color:var(--muted)}
.metrics>div,.layers,.appearance,.sidebar-bottom,.session dl{border-color:var(--edge)}
#scene-wrap,#map-stage{background:#eceef0}
.info-panel,.grid-label,.scale-label,.controls-hint,#coordinates,.height-legend,#scale,.north{color:var(--ink);background:#f8f9faed;border:1px solid var(--edge);border-radius:3px;box-shadow:none}
.grid-label i,.scale-label span:first-child,#scale i{border-color:#555f67}
#loading,#empty-state{background:#f1f2f3eb;color:var(--ink)}
.map-controls,dialog,#toast{box-shadow:none}.map-controls{border-color:var(--edge)}#toast{background:#41474d}
body:has(#pointcloud-app) .toolbar{order:2;border-top:1px solid var(--edge)}
body:has(#bagForm)>header{order:2;border:0;border-top:1px solid var(--edge)}
#status{color:var(--muted)}
/* Shared action surface; selected tools use the saturated amber. */
body button,body .button,.toolbar .file-button,.bar nav a,.bar .ant-btn,.directory-picker .cancel,#folders button,.rig-layout td button,.view-switch button,.map-controls button,.toolbar #reset-view,.bar .load-map {
  background:var(--action)!important;color:#30220d!important;border:1px solid #dfa044;border-radius:3px;box-shadow:none!important;font-weight:550
}
.bar nav a,.bar nav .ant-btn,.rig-views button,.view-switch button,.toolbar .views button {background:var(--tint)!important}
body button:not(:disabled):hover,body .button:hover,.toolbar .file-button:hover,.bar nav a:hover,
.bar nav .ant-btn[aria-pressed=true],.rig-views button[aria-pressed=true],.toolbar button.active,.view-switch button.selected {
  background:var(--active)!important;color:#271a08!important;border-color:#c47d18
}
body button:disabled{opacity:.48;cursor:default}
body .text-button{padding:5px 9px}
@media(max-width:980px){
 .mapping-workspace{grid-template-columns:minmax(0,1.2fr) minmax(270px,1fr)}
 .bar{grid-template-columns:1fr;gap:6px}.bar nav{row-gap:4px}.map-picker{grid-column:1}
}
@media(max-width:720px){
 .mapping-workspace{display:flex;flex-direction:column}.workspace-card{width:100%}
 .workspace-card.rig-section{order:0}.workspace-card.mapping-columns{order:1}.workspace-card.rig-layout{order:2}
 #rig-canvas{user-select:none;touch-action:none;cursor:grab;height:260px}.bar nav .ant-btn,.bar nav a{padding:5px 8px}
}

#studio { display:grid; grid-template-columns:166px minmax(0,1fr); grid-template-rows:minmax(0,1fr) }
#studio>.bar { display:flex; flex-direction:column; align-items:stretch; gap:22px; padding:18px 12px; border:0; border-right:1px solid var(--edge); overflow-y:auto }
#studio .bar nav { display:grid; grid-template-columns:minmax(0,1fr); gap:7px }
#studio .bar nav>* { width:100%; justify-content:flex-start; height:37px }
.studio-content { display:flex; flex-direction:column; min-width:0; min-height:0 }
.studio-content>.map-picker { display:flex; flex-wrap:wrap; align-items:center; gap:8px; padding:10px 14px; background:var(--panel); border:0; border-bottom:1px solid var(--edge) }
.studio-content .map-picker label { flex:1 1 220px }
.studio-content .map-picker select { flex:1; width:auto; margin:0; padding:6px }
.studio-content .map-picker button { width:auto; height:34px; padding:5px 12px }
@media(max-width:640px){
 #studio { grid-template-columns:110px minmax(0,1fr) }
 #studio>.bar { padding:12px 5px }
 #studio .bar .brand { font-size:14px;gap:3px }
 #studio .brand img { width:16px;height:16px }
 #studio .bar nav>* { padding:5px;font-size:12px }
}
