Panels:
- Class: rviz_common/Displays
  Name: Displays
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Global Options:
    Background Color: 24; 27; 32
    Fixed Frame: map
    Frame Rate: 5
  Displays:
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: false
    Marker Scale: 0.15
    Frames:
      All Enabled: true
  - Class: rviz_default_plugins/Grid
    Name: Ground grid (1 m)
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 100
    Color: 90; 90; 90
    Alpha: 0.3
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/PointCloud2
    Name: LIO-SAM registered scan
    Enabled: true
    Topic:
      Value: /lio_sam/mapping/cloud_registered
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Style: Points
    Size (Pixels): 2
    Size (m): 0.03
    Decay Time: 0
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Channel Name: intensity
    Autocompute Intensity Bounds: true
    Use rainbow: true
    Min Color: 0; 50; 255
    Max Color: 255; 80; 0
    Color: 255; 220; 80
  - Class: rviz_default_plugins/PointCloud2
    Name: LIO-SAM map
    Enabled: true
    Topic:
      Value: /lio_sam/mapping/map_global
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Style: Points
    Size (Pixels): 2
    Size (m): 0.03
    Decay Time: 0
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Channel Name: intensity
    Autocompute Intensity Bounds: true
    Use rainbow: true
    Min Color: 0; 50; 255
    Max Color: 255; 80; 0
    Color: 100; 210; 255
  - Class: rviz_default_plugins/Path
    Name: LIO-SAM trajectory
    Enabled: true
    Topic:
      Value: /lio_sam/mapping/path
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Color: 255; 80; 80
    Line Style: Lines
    Line Width: 0.08
    Buffer Length: 1
  - Class: rviz_default_plugins/PointCloud2
    Name: Four lidar filtered (lidar 1 time)
    Enabled: false
    Topic:
      Value: /lidars/filtered_points
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      History Policy: Keep Last
      Depth: 5
    Style: Points
    Size (Pixels): 2
    Size (m): 0.03
    Decay Time: 0
    Position Transformer: XYZ
    Color Transformer: Intensity
    Channel Name: lidar_id
    Autocompute Intensity Bounds: true
    Use rainbow: true
    Min Color: 0; 50; 255
    Max Color: 255; 80; 0
    Color: 255; 220; 80
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 190.0
      Pitch: 1.0
      Yaw: 0.7
      Focal Point:
        X: 0
        Y: 60
        Z: 0
      Target Frame: <Fixed Frame>
  Enabled: true
Window Geometry:
  Width: 1100
  Height: 800
  X: 50
  Y: 50
